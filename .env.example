APP_ENV="local"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/redionflow?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/redionflow?schema=public"
OPENAI_API_KEY=""
APP_BASE_URL="http://localhost:3000"
APP_DOMAIN="localhost"
DEMO_MODE="false"
DEMO_RESET_ALLOWED="false"
# Demo seed product: "baumdienst" (default), "bau" (BauFlow) or "glasfaser" (BauFlow, fiber civil works).
DEMO_SEED_MODE=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET_WORKERS="worker-assets"
SUPABASE_STORAGE_BUCKET_BAUSTELLEN="baustelle-documents"
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FLEET_GPS_INGEST_TOKEN=""

# BDF-P1-001 — gated demo/local admin bootstrap.
# The application no longer contains hard-coded admin PINs. To seed a
# single local admin for development or demo, set ALL THREE of:
#   ALLOW_DEMO_ADMIN_BOOTSTRAP=true
#   DEMO_ADMIN_EMAIL=<your@dev.email>
#   DEMO_ADMIN_PASSWORD=<>= 8 chars, never committed>
# The gate additionally requires APP_ENV=local|demo and SAAS_MODE unset or
# false. Production and SaaS deployments always ignore these vars.
ALLOW_DEMO_ADMIN_BOOTSTRAP=""
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""

# BDF-P1-005 — gated demo/local display bootstrap.
# Parallels the admin demo bootstrap for the STAFF/display role. Set all
# three to seed one display login on a local or demo deployment:
#   ALLOW_DEMO_DISPLAY_BOOTSTRAP=true
#   DEMO_DISPLAY_EMAIL=<your@dev.email>
#   DEMO_DISPLAY_PASSWORD=<>= 8 chars, never committed>
# Gate additionally requires APP_ENV=local|demo and SAAS_MODE unset/false.
# Production/SaaS ignore these variables.
ALLOW_DEMO_DISPLAY_BOOTSTRAP=""
DEMO_DISPLAY_EMAIL=""
DEMO_DISPLAY_PASSWORD=""

# BDF-P1-002 — safe first-boot administrator setup.
# The `/first-boot` page is 404 by default. Enable it ONLY on a fresh
# dedicated deployment where the admin table is empty and you are about to
# create the initial administrator.
#   FIRST_BOOT_SETUP_ENABLED=true
#   FIRST_BOOT_SETUP_TOKEN=$(openssl rand -hex 32)   # >=32 random bytes
# After the initial admin is created, unset both variables and rotate any
# channel (Slack, email, chat) that carried the token. The token must
# never be committed and must never be reused. SaaS deployments ignore
# these variables — see .env.saas.example.
FIRST_BOOT_SETUP_ENABLED=""
FIRST_BOOT_SETUP_TOKEN=""

# BDF-P1-003 — durable login rate limiter (see docs/adr/0001-...).
# Salt for pseudonymising client IPs before hashing. Must encode AT LEAST
# 32 random bytes. Accepted encodings:
#   - hex:       >=64 characters from [0-9a-fA-F]  (recommended)
#   - base64url: >=43 characters from [A-Za-z0-9_-]
# Recommended generator: `openssl rand -hex 32`.
# An arbitrary 32-character string is NOT accepted — the value must be a
# valid encoding of at least 32 random bytes.
# Policy (see src/lib/auth/client-key.ts):
#   - APP_ENV in {local, demo, test} without SaaS: unset/invalid =>
#     per-process random fallback + one-time warning (safe for developer
#     shells).
#   - APP_ENV in {production, saas} or SAAS_MODE=true: unset/invalid salt
#     causes login attempts to fail closed until the value is provided.
# Rotate the salt to invalidate every stored bucket (e.g. after a
# suspected leak). Schedule `npm run login-attempts:cleanup` periodically
# (e.g. hourly) so retention is enforced during idle traffic windows.
LOGIN_GUARD_SALT=""
# Storage backend override. Leave empty for the Postgres-backed adapter
# (production default). Set `memory` for unit tests only. The Postgres
# adapter uses the same DATABASE_URL as the rest of the app.
LOGIN_ATTEMPT_STORE=""

# Required server-only session signing key (at least 32 random characters).
# Changing it invalidates all cookies; legacy ID cookies are rejected.
SESSION_SIGNING_SECRET=

# Separate PRIVATE document buckets. App verifies bucket public=false before writes/reads.
# Provision only in an authorized environment; public/legacy assets are not migrated here.
SUPABASE_STORAGE_PRIVATE_BUCKET_WORKERS="worker-private"
SUPABASE_STORAGE_PRIVATE_BUCKET_BAUSTELLEN="baustelle-private"
# No real malware scanner is implemented. Explicit none allows unscanned uploads;
# an unsupported backend refuses uploads rather than silently falling back.
CONTENT_SCANNER="none"

# Bounded LOCAL runtime RLS pilot only. Official disposable runners provision
# the restricted LOGIN and supply a fresh random secret URL, never stored here.
# RLS_ENFORCE=true adopts only Company READ, sites and DailyPlan pilot queries.
# Hosted/global rollout is not implemented; privileged fallback is forbidden.
TENANT_DATABASE_URL=""
TENANT_DB_POOL_MAX="1"
