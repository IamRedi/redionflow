# RediOnFlow SaaS — Vercel + Supabase environment template.
#
# Copy this file into Vercel's Environment Variables settings for the SaaS
# project. Values below marked `<...>` must be replaced with real secrets.
# Never commit real secrets to the repo.
#
# For the local dev workspace use `.env.example` instead — this file targets
# the production SaaS deployment on Vercel.

# --------------------------------------------------------------------------
# Deployment mode (T-026)
# --------------------------------------------------------------------------
# `true` gates /signup, /login, Stripe webhook, and per-tenant limits.
# Set to `false` (or leave unset) for dedicated single-client deployments.
SAAS_MODE="true"

# Environment tag used for logging/telemetry and for guarding destructive
# scripts. SaaS = "saas".
APP_ENV="saas"

# --------------------------------------------------------------------------
# Public URLs
# --------------------------------------------------------------------------
# Absolute URL used in emails, Stripe redirects, and OpenGraph.
APP_BASE_URL="https://app.redionflow.example"
APP_DOMAIN="app.redionflow.example"

# --------------------------------------------------------------------------
# Database (Supabase Postgres)
# --------------------------------------------------------------------------
# DATABASE_URL is the pooled connection (port 6543, transaction pooling).
# Vercel serverless MUST use the pooler — direct connections exhaust
# Supabase's connection limit quickly.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL is the direct connection (port 5432) used by `prisma migrate
# deploy`. Prisma refuses to run migrations through the pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --------------------------------------------------------------------------
# Supabase Storage
# --------------------------------------------------------------------------
# Server-only. Never expose to the browser.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET_WORKERS="worker-assets"
SUPABASE_STORAGE_BUCKET_BAUSTELLEN="baustelle-documents"

# --------------------------------------------------------------------------
# Stripe (T-027)
# --------------------------------------------------------------------------
# Required in SaaS mode. Webhook endpoint on this deployment is
# POST /api/stripe/webhook — configure the Stripe dashboard to point there.
STRIPE_SECRET_KEY="sk_live_<...>"
STRIPE_WEBHOOK_SECRET="whsec_<...>"

# --------------------------------------------------------------------------
# Row-Level Security (T-034)
# --------------------------------------------------------------------------
# Start at `false`. Flip to `true` in staging first once every server
# action and API route wraps DB access in `withTenantContext`. See
# `docs/RLS.md` for the rollout playbook.
RLS_ENFORCE="false"

# --------------------------------------------------------------------------
# Fleet GPS ingest (T-034)
# --------------------------------------------------------------------------
# On SaaS every tenant creates their own token via the admin UI.
# The env fallback is optional — leave empty on SaaS.
FLEET_GPS_INGEST_TOKEN=""

# --------------------------------------------------------------------------
# OpenAI (Assistant features)
# --------------------------------------------------------------------------
# Optional. When empty, assistant features degrade gracefully to a
# read-only view instead of returning 500s.
OPENAI_API_KEY=""

# --------------------------------------------------------------------------
# Firebase Cloud Messaging (worker push notifications)
# --------------------------------------------------------------------------
# Optional. Leave empty to disable push notifications on the SaaS surface.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --------------------------------------------------------------------------
# Demo mode guards — always OFF on SaaS
# --------------------------------------------------------------------------
DEMO_MODE="false"
DEMO_RESET_ALLOWED="false"

# --------------------------------------------------------------------------
# BDF-P1-001 — demo/local admin bootstrap must remain OFF on SaaS
# --------------------------------------------------------------------------
# The gate additionally requires APP_ENV=local|demo, so these variables are
# ignored on SaaS even if set. Kept here (empty) so operators can grep the
# template and confirm the values are not accidentally configured.
ALLOW_DEMO_ADMIN_BOOTSTRAP=""
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""

# --------------------------------------------------------------------------
# BDF-P1-005 — demo/local display bootstrap must remain OFF on SaaS
# --------------------------------------------------------------------------
ALLOW_DEMO_DISPLAY_BOOTSTRAP=""
DEMO_DISPLAY_EMAIL=""
DEMO_DISPLAY_PASSWORD=""

# --------------------------------------------------------------------------
# BDF-P1-002 — first-boot administrator setup: DISABLED on SaaS
# --------------------------------------------------------------------------
# SaaS deployments always ignore these variables. Tenant administrators
# are created through the `/signup` flow. Kept here (empty) so operators
# can grep the template and confirm the values are not accidentally set.
FIRST_BOOT_SETUP_ENABLED=""
FIRST_BOOT_SETUP_TOKEN=""

# --------------------------------------------------------------------------
# BDF-P1-003 — durable login rate limiter salt
# --------------------------------------------------------------------------
# REQUIRED on SaaS and every long-lived deployment. Must encode >=32
# random bytes. Accepted encodings:
#   - hex:       >=64 characters from [0-9a-fA-F]  (recommended)
#   - base64url: >=43 characters from [A-Za-z0-9_-]
# Recommended generator: `openssl rand -hex 32`.
# Persists across restarts and replicas — the value must match on every
# instance. Rotate after any credential/store incident to invalidate
# every stored bucket. If unset or invalid, all login attempts fail
# closed until the value is provided.
# Schedule `npm run login-attempts:cleanup` (or the equivalent
# `tsx scripts/login-attempts-cleanup.ts` invocation) at least hourly.
LOGIN_GUARD_SALT=""
# Leave unset in SaaS — the Postgres-backed adapter is the only supported
# production backend.
LOGIN_ATTEMPT_STORE=""

# Required server-only session signing key (at least 32 random characters).
# Changing it invalidates all cookies; legacy ID cookies are rejected.
SESSION_SIGNING_SECRET=

# Separate PRIVATE document buckets. App verifies bucket public=false before writes/reads.
# Provision only in an authorized environment; public/legacy assets are not migrated here.
SUPABASE_STORAGE_PRIVATE_BUCKET_WORKERS="worker-private"
SUPABASE_STORAGE_PRIVATE_BUCKET_BAUSTELLEN="baustelle-private"
# No real malware scanner is implemented. Explicit none allows unscanned uploads;
# an unsupported backend refuses uploads rather than silently falling back.
CONTENT_SCANNER="none"
