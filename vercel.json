{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "prod": false
    }
  },
  "functions": {
    "src/app/api/stripe/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/workzone/sync/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/workzone/sync/upload/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/portability/export/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/realtime/updates/route.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/api/stripe/webhook",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/portability/export",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
