  completedByUser     User?     @relation("TreeCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  completedByWorkerId String?
  completedByWorker   Worker?   @relation("TreeCompletedByWorker", fields: [completedByWorkerId], references: [id], onDelete: SetNull)

