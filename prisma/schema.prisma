// Idempotency log for Workzone offline sync. Each processed client action is
// stored here so that retries after network failures cannot be applied twice.
model WorkzoneSyncAction {
  id               String         @id // client-generated UUID (idempotency key)
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  actorKind  String // "WORKER" | "ADMIN"
  actorId    String
  actionType String // e.g. "START_WORK", "STOP_WORK", "CHECK_TREE"
  entityType String // e.g. "WORK_SESSION", "TREE", "BAUSTELLE"
  entityId   String

  payload Json

  outcome    String // "synced" | "noop" | "conflict" | "rejected"
  outcomeMsg String? // human-readable detail for the UI / admin review

  processedAt DateTime @default(now())

  @@index([companyProfileId, processedAt])
  @@index([actorId, processedAt])
  @@index([actionType, entityId])
}

/// BDF-P1-003 — durable login rate-limiter storage. One row per
/// `(scope, clientKey)` pair. See ADR-0001
/// (`docs/adr/0001-login-rate-limiter-backend.md`). `clientKey` is
/// `sha256(LOGIN_GUARD_SALT || ':' || scope || ':' || ip)` — raw IPs are
/// never persisted. Cleaned up opportunistically by the store.
model LoginAttempt {
  id             String    @id @default(cuid())
  scope          String
  clientKey      String
  attempts       Int       @default(0)
  firstAttemptAt DateTime  @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([scope, clientKey])
  @@index([updatedAt])
}

/// Factory production (BauFlow "Stahlbau mit Produktion"): a group of
/// material processed in the factory for one construction site.
model ProductionBatch {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  baustelleId      String
  baustelle        Baustelle      @relation(fields: [baustelleId], references: [id], onDelete: Cascade)
  title            String
  quantity         Float?
  unit             String         @default("t")
  /// Ordered line: [{ key, status, note, by, at }]
  steps            Json
  readyAt          DateTime?
  createdByName    String         @default("")
  /// Supplier order this material came from (order number), if any.
  orderRef         String?
  /// The order document (SiteFile) this material was imported from; deleting
  /// the document deletes these batches.
  siteFileId       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  events           ProductionEvent[]

  @@index([companyProfileId])
  @@index([baustelleId])
  @@index([siteFileId])
}

/// Append-only history of every change on a production batch.
model ProductionEvent {
  id               String          @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile  @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  batchId          String
  batch            ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stepKey          String?
  action           String
  fromStatus       String?
  toStatus         String?
  note             String?
  actorName        String
  actorUserId      String?
  actorWorkerId    String?
  createdAt        DateTime        @default(now())

  @@index([batchId])
  @@index([companyProfileId])
}

/// Files of one construction site kept in the database (pilot storage):
/// documents and photos for the team, orders and invoices for the office.
model CompanyAssetCode {
  id String @id @default(cuid())
  companyProfileId String
  companyProfile CompanyProfile @relation(fields:[companyProfileId],references:[id],onDelete:Cascade)
  assetId String
  asset CompanyOperationalAsset @relation(fields:[companyProfileId,assetId],references:[companyProfileId,id],onDelete:Restrict)
  kind String
  value String
  matchValue String
  revokedAt DateTime?
  createdByKey String
  createdByName String
  createdAt DateTime @default(now())
  @@unique([companyProfileId,assetId,kind,matchValue])
  @@index([companyProfileId,matchValue])
}

/// Explicit, tenant-scoped permission for an engineer to upload to one site.
/// Per-place access given with the key button: "view" (Shikon) or "act" (Vepron).
/// scopeId is the site id for site grants, "" for a whole place.
model AccessGrant {
  id String @id @default(cuid())
  companyProfileId String
  companyProfile CompanyProfile @relation(fields:[companyProfileId],references:[id],onDelete:Cascade)
  place String
  scopeId String @default("")
  workerId String
  worker Worker @relation(fields:[companyProfileId,workerId],references:[companyProfileId,id],onDelete:Cascade)
  level String
  grantedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyProfileId,place,scopeId,workerId])
  @@index([companyProfileId,workerId])
}

model SiteDocumentEngineer {
  id String @id @default(cuid())
  companyProfileId String
  companyProfile CompanyProfile @relation(fields:[companyProfileId],references:[id],onDelete:Cascade)
  baustelleId String
  baustelle Baustelle @relation(fields:[companyProfileId,baustelleId],references:[companyProfileId,id],onDelete:Cascade)
  workerId String
  worker Worker @relation(fields:[companyProfileId,workerId],references:[companyProfileId,id],onDelete:Cascade)
  grantedByUserId String
  grantedBy User @relation("SiteDocumentGrantedBy",fields:[companyProfileId,grantedByUserId],references:[companyProfileId,id],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@unique([companyProfileId,baustelleId,workerId])
  @@index([companyProfileId,workerId])
