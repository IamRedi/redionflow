model Worker {
  siteDocumentGrants SiteDocumentEngineer[]
  accessGrants AccessGrant[]
  phaseDocuments SitePhaseDocument[] @relation("PhaseDocumentWorker")
  phaseReceipts SitePhaseDocumentReceipt[] @relation("PhaseReceiptWorker")
  operationalAssets CompanyOperationalAsset[] @relation("AssetHolder")
  assetHandoversFrom CompanyAssetHandover[] @relation("AssetHandoverFrom")
  assetHandoversTo CompanyAssetHandover[] @relation("AssetHandoverTo")
  assetRepairOrigins CompanyAssetRepair[] @relation("AssetRepairOrigin")
  companyAssetFiles CompanyAssetFile[] @relation("AssetFileWorker")
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  firstName             String
  lastName              String
  phone                 String?
  position              String?
  licenses              String?
  status                WorkerStatus       @default(active)
  availability          WorkerAvailability @default(AVAILABLE)
  vacationAllowanceDays Int                @default(26)
  loginCode             String?            @unique
  /// BDF-P1-005: scrypt hash of the worker login code. New writes go
  /// here via `hashPassword`; `loginCode` remains as a legacy read-only
  /// column and is no longer used for authentication. See ADR-0001 and
  /// BDF-P1-005.
  loginCodeHash         String?
  isTemporary           Boolean            @default(false)
  birthDate             DateTime?
  /// National ID / personal number from the company's staff list. HR data:
  /// shown only on the worker's own profile and to the office.
  nationalId            String?
  startedAtCompany      DateTime?
  emailAccount          String?
  clothingTopSize       String?
  clothingBottomSize    String?
  shoeSize              String?
  profileImageUrl       String?
  profilePhoto          AssetPhoto?
  documents             Json?
  level                 WorkerLevel        @default(JUNIOR)
  /// Metal construction role (see src/lib/workzone/crew-roles.ts); null = plain worker.
  crewRole              String?
  /// Access level (src/lib/access/rules.ts): BASE or FULL_VIEW; null = derived from crewRole.
  accessLevel           String?
  /// AI assistant access when the company limits it to selected people.
  assistantAccess       Boolean              @default(false)
  preferredLanguage     AssistantLanguage  @default(DE)
  motherTongue          AssistantLanguage  @default(DE)
  aiPersonalityNote     String?
  addedByWorkerId       String?
  addedByWorker         Worker?            @relation("WorkerAddedBy", fields: [addedByWorkerId], references: [id], onDelete: SetNull)
  addedWorkers          Worker[]           @relation("WorkerAddedBy")

  sessions                WorkSession[]
  completedTreeItems      TreeItem[]                 @relation("TreeCompletedByWorker")
  manualTasks             ManualTask[]
  resolvedManualTasks     ManualTask[]               @relation("ManualTaskResolvedByWorker")
  reportNotes             WorkReportNote[]
  assetItems              WorkerAssetItem[]
  dailyPlanAssignments    DailyWorkPlanAssignment[]
  inventoryMovements      InventoryMovement[]
  inventoryAssetMovements InventoryAssetMovement[]
  coneMovements           MachineConeMovement[]      @relation("ConeActorWorker")
  vacationRequests        VacationRequest[]
  pauseIntervals          WorkSessionPauseInterval[]
  phoneGpsLocationPoints  GpsLocationPoint[]         @relation("WorkerPhoneGpsLocationPoints")

  /// BDF-P8-007 session revocation. Same semantics as `User.sessionEpoch`
  /// but scoped to worker sessions (Workzone worker cookie). Login-code
  /// rotation or an admin's "log this worker out everywhere" action
  /// bumps this number.
  sessionEpoch Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyProfileId])
  @@index([status])
  @@index([availability])
  @@unique([companyProfileId,id])
}

/// Operational overlay; existing machines, issued rows and history are retained.
model CompanyOperationalAsset {
  codes CompanyAssetCode[]
  id String @id @default(cuid())
  companyProfileId String
  companyProfile CompanyProfile @relation(fields:[companyProfileId],references:[id],onDelete:Cascade)
  machineId String? @unique
  machine Machine? @relation(fields:[companyProfileId,machineId],references:[companyProfileId,id],onDelete:Restrict)
  inventoryItemId String? @unique
  inventoryItem CompanyInventoryItem? @relation(fields:[companyProfileId,inventoryItemId],references:[companyProfileId,id],onDelete:Restrict)
  disposition String @default("active")
  revision Int @default(0)
  holderWorkerId String?
  holder Worker? @relation("AssetHolder",fields:[companyProfileId,holderWorkerId],references:[companyProfileId,id],onDelete:Restrict)
  siteId String?
  site Baustelle? @relation("AssetSite",fields:[companyProfileId,siteId],references:[companyProfileId,id],onDelete:Restrict)
  wasActive Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  handovers CompanyAssetHandover[]
  incidents CompanyAssetIncident[]
  repairs CompanyAssetRepair[]
  events CompanyAssetEvent[]
  files CompanyAssetFile[]
  @@unique([companyProfileId,id])
  @@index([companyProfileId,disposition])
  @@unique([companyProfileId,machineId])
  @@unique([companyProfileId,inventoryItemId])
}

