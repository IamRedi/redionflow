generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  SENT
  ACCEPTED
  LOST
  ARCHIVED
}

enum WageType {
  HOURLY
  MONTHLY
}

enum MachineCategory {
  CHIPPER
  TRUCK
  AWP
  CHAINSAW
  OTHER
}

enum OverheadBase {
  EK_TOTAL
  LABOR_ONLY
}

enum RiskProfitMode {
  SEPARATE
  COMBINED
}

enum MachineTimeUnit {
  HOURS
  DAYS
}

enum BaustelleStatus {
  active
  inactive
}

enum BaustelleType {
  // Baumdienst work types
  TRUCK_PLATFORM
  TRUCK_CRANE
  CLIMBING
  WATERING
  EXCAVATOR
  // Bau (construction) work types
  SIGNAGE
  DRAINAGE
  WALL
  PAVING
  PAINTING
  RENOVATION
  // Fiber-optic civil works (Glasfaser-Tiefbau)
  FIBER_TRENCH
  FIBER_DRILLING
  FIBER_HOUSE_CONNECTION
  // Metal construction (Stahlbau)
  STEEL_WORKSHOP
  STEEL_ASSEMBLY
  OTHER
}

enum TreeItemStatus {
  todo
  done
  blocked
}

enum WorkerStatus {
  active
  inactive
}

enum WorkerLevel {
  JUNIOR
  WORKER
  SENIOR
  VORARBEITER
  MEISTER
}

enum WorkerAvailability {
  AVAILABLE
  SICK
  VACATION
  UNAVAILABLE
}

enum VacationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkReportType {
  DAILY
  MONTHLY
}

enum WorkerAssetKind {
  CLOTHING
  EQUIPMENT
}

enum CompanyInventoryCategory {
  WORK_TOOL
  CLOTHING
  SITE_EQUIPMENT
}

enum WorkerAssetStatus {
  PENDING_ADMIN_CONFIRMATION
  PENDING_WORKER_CONFIRMATION
  ACTIVE
  PENDING_ADMIN_DELETE_CONFIRMATION
  PENDING_WORKER_DELETE_CONFIRMATION
  DELETED
}

enum WorkerAssetActorRole {
  ADMIN
  WORKER
  SYSTEM
}

enum MachineConeMovementType {
  DEPLOY
  COLLECT
  TRANSFER
}

enum MachineConeActorRole {
  ADMIN
  WORKER
  SYSTEM
}

enum GpsPointSource {
  MACHINE
  WORKER_PHONE
}

enum MachinePresenceSource {
  MACHINE_GPS
  WORKER_PHONE
  MANUAL
  SYSTEM
}

enum DailyPlanAssignmentKind {
  WORKER
  MACHINE
}

enum SiteEquipmentCategory {
  SIGN
  PLATE
  FENCE
  OTHER
}

enum InventoryMovementType {
  DEPLOY
  COLLECT
}

enum AssistantLanguage {
  DE
  EN
  SQ
  IT
  PL
  RO
}

model User {
  siteDocumentGrants SiteDocumentEngineer[] @relation("SiteDocumentGrantedBy")
  phaseDocuments SitePhaseDocument[] @relation("PhaseDocumentUser")
  phaseReceipts SitePhaseDocumentReceipt[] @relation("PhaseReceiptUser")
  companyAssetFiles CompanyAssetFile[] @relation("AssetFileUser")
  id                String            @id @default(cuid())
  email             String            @unique
  name              String?
  role              UserRole          @default(STAFF)
  passwordHash      String?
  /// Optional owner-only name/PIN shortcut; separate from the email password.
  loginPinHash      String?
  isActive          Boolean           @default(true)
  /// The company owner: the admin created by signup or first boot. Only the
  /// owner may add, edit or deactivate other admins, and the owner itself
  /// cannot be edited or removed by them.
  isOwner           Boolean           @default(false)
  /// AI assistant access when the company limits it to selected people.
  assistantAccess   Boolean           @default(false)
  preferredLanguage AssistantLanguage @default(DE)
  motherTongue      AssistantLanguage @default(DE)
  aiPersonalityNote String?

  /// T-026: link admin/staff to their tenant. Nullable during dedicated
  /// backfill; SaaS signup always sets this. `getCurrentCompanyId` prefers
  /// this over the fall-back "first company" lookup.
  companyProfileId String?
  companyProfile   CompanyProfile? @relation("CompanyUsers", fields: [companyProfileId], references: [id], onDelete: SetNull)

  workLogs                  WorkLog[]
  completedTreeItems        TreeItem[]               @relation("TreeCompletedBy")
  manualTasks               ManualTask[]
  resolvedManualTasks       ManualTask[]             @relation("ManualTaskResolvedByUser")
  createdDailyPlans         DailyWorkPlan[]          @relation("DailyPlanCreatedBy")
  createdDailyPlanSnapshots DailyWorkPlanSnapshot[]  @relation("DailyPlanSnapshotCreatedBy")
  inventoryMovements        InventoryMovement[]      @relation("InventoryMovementActorAdmin")
  inventoryAssetMovements   InventoryAssetMovement[] @relation("InventoryAssetMovementActorAdmin")
  coneMovements             MachineConeMovement[]    @relation("ConeActorAdmin")
  reviewedVacationRequests  VacationRequest[]        @relation("VacationReviewedBy")

  /// BDF-P8-007 session revocation. Any live session cookie carries the
  /// epoch that was in force when it was issued. Password rotation,
  /// admin removal, or explicit "sign out everywhere" bumps this
  /// number; enforcement compares the cookie epoch against the DB
  /// epoch and rejects mismatches.
  ///
  /// Phase 1 (this migration) only introduces the column with default
  /// 0. Enforcement wires in a follow-up PR so existing sessions
  /// created before the schema change continue to work — they read
  /// as epoch 0 and match the row default.
  sessionEpoch Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyProfileId])
  @@unique([companyProfileId,id])
}

model CompanyProfile {
  accessGrants AccessGrant[]
  platformSignals PlatformSignal[]
  siteDocumentEngineers SiteDocumentEngineer[]
  phaseDocuments SitePhaseDocument[]
  phaseReceipts SitePhaseDocumentReceipt[]
  assetCodes CompanyAssetCode[]
  operationalAssets CompanyOperationalAsset[]
  assetHandovers CompanyAssetHandover[]
  assetIncidents CompanyAssetIncident[]
  assetRepairs CompanyAssetRepair[]
  assetEvents CompanyAssetEvent[]
  assetFiles CompanyAssetFile[]
  assetCommandReceipts CompanyAssetCommandReceipt[]
  steelWorkDefinitions SteelWorkDefinition[]
  steelWorkVisuals SteelWorkVisual[]
  steelSiteTasks SteelSiteTask[]
  assistantQuotaBuckets AssistantQuotaBucket[]
  assistantConversations AssistantConversation[]
  assistantRuns AssistantRun[]
  assistantToolTraces AssistantToolTrace[]
  wanwayIntegration WanwayIntegration?
  id                    String  @id @default(cuid())
  legalName             String
  displayName           String
  vatId                 String?
  phone                 String?
  email                 String?
  /// "baumdienst" | "bau" — controls feature flags and product branding (DB CHECK constraint)
  mode                  String  @default("baumdienst")
  /// "DE" | "AL" — currency, public holidays and defaults (DB CHECK constraint)
  country               String  @default("DE")
  /// Company logo as a data: URL (png, jpeg, webp or svg), shown in the top bar
  logoDataUrl           String?
  fleetGpsEnabled       Boolean @default(false)
  workerPhoneGpsEnabled Boolean @default(false)
  /// KiDraht (company knowledge, rules and briefings): the company's workspace id and API key there.
  /// Created automatically on first open; the key signs the short sign-in links and is never shown.
  kidrahtWorkspaceId    String?
  kidrahtApiKey         String?
  /// true = only the owner and people with assistantAccess may use the AI assistant.
  assistantAccessSelected Boolean            @default(false)

  street String?
  zip    String?
  city   String?

  overheadSettings          OverheadSettings?
  laborRoles                LaborRole[]
  machines                  Machine[]
  fuelReceipts              FuelReceipt[]
  workers                   Worker[]
  inventoryItems            CompanyInventoryItem[]
  productionBatches         ProductionBatch[]
  productionEvents          ProductionEvent[]
  siteFiles                 SiteFile[]
  siteElements              SiteElement[]
  siteElementWork           SiteElementWork[]
  inventoryCatalog          CompanyInventoryCatalog[]
  inventoryMovements        InventoryMovement[]
  inventoryAssetMovements   InventoryAssetMovement[]
  coneMovements             MachineConeMovement[]
  vacationRequests          VacationRequest[]
  templates                 CalculationTemplate[]
  projects                  Project[]
  dailyPlans                DailyWorkPlan[]
  workzoneAnnouncements     WorkzoneAnnouncement[]
  gpsLocationPoints         GpsLocationPoint[]
  machineBaustellePresences MachineBaustellePresence[]

  baustellen          Baustelle[]
  knowledge           CompanyKnowledge[]
  workzoneSyncActions WorkzoneSyncAction[]
  users               User[]               @relation("CompanyUsers")
  auditLogs           AuditLog[]
  assetPhotos         AssetPhoto[]
  managedFiles        ManagedFile[]

  /// T-026: SaaS trial expiry. Null for dedicated deployments.
  trialEndsAt DateTime?

  /// T-027: SaaS Stripe customer id. Null for dedicated deployments and for
  /// SaaS tenants that have not opened checkout yet.
  stripeCustomerId String?
  subscription     Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-tenant cost limits only; never contains prompts, transcripts or API keys.
model AssistantQuotaBucket {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  actorKey         String
  window           String
  windowStart      DateTime
  requests         Int            @default(0)
  tokens           Int            @default(0)

  @@unique([companyProfileId, actorKey, window, windowStart], map: "AssistantQuotaBucket_scope_window_key")
  @@index([companyProfileId, windowStart])
}

/// Private admin-owned history, separate from cost buckets and sensitive-action audit logs.
model AssistantConversation {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  /// Historical actor ID; removing an admin must not delete or reassign a transcript.
  adminId          String
  title            String
  clientContext    Json?
  contextUnverified Boolean       @default(false)
  contextRedacted  Boolean        @default(false)
  contextTruncated Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lastRunAt        DateTime       @default(now())
  runs             AssistantRun[]

  @@unique([companyProfileId, adminId, id], map: "AssistantConversation_owner_id_key")
  @@index([companyProfileId, adminId, lastRunAt, id], map: "AssistantConversation_owner_time_idx")
}

/// One server-accepted question and the exact emitted answer (secret-redacted).
model AssistantRun {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  adminId          String
  conversationId   String
  conversation     AssistantConversation @relation(fields: [companyProfileId, adminId, conversationId], references: [companyProfileId, adminId, id], onDelete: Cascade, map: "AssistantRun_conversation_owner_fkey")
  clientMessageId  String?
  question         String
  answer           String         @default("")
  status           String         @default("running")
  model            String?
  finishReason     String?
  errorCode        String?
  httpStatus       Int?
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  diagnostics      Json?
  diagnosticsRedacted Boolean    @default(false)
  diagnosticsTruncated Boolean   @default(false)
  questionRedacted Boolean        @default(false)
  answerRedacted   Boolean        @default(false)
  answerTruncated  Boolean        @default(false)
  traceTruncated   Boolean        @default(false)
  traceBytes       Int            @default(0)
  startedAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  finishedAt       DateTime?
  toolTraces       AssistantToolTrace[]

  @@unique([companyProfileId, adminId, id], map: "AssistantRun_owner_id_key")
  @@unique([companyProfileId, adminId, clientMessageId], map: "AssistantRun_owner_message_key")
  @@index([companyProfileId, adminId, conversationId, startedAt, id], map: "AssistantRun_conversation_time_idx")
}

/// Bounded sanitized execution evidence. Never provider headers or raw exceptions.
model AssistantToolTrace {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  adminId          String
  runId            String
  run              AssistantRun   @relation(fields: [companyProfileId, adminId, runId], references: [companyProfileId, adminId, id], onDelete: Cascade, map: "AssistantToolTrace_run_owner_fkey")
  toolCallId       String
  toolName         String
  step             Int?
  status           String
  input            Json?
  result           Json?
  evidence         Json?
  redacted         Boolean        @default(false)
  truncated        Boolean        @default(false)
  originalBytes    Int            @default(0)
  storedBytes      Int            @default(0)
  startedAt        DateTime       @default(now())
  durationMs       Int?
  createdAt        DateTime       @default(now())

  @@unique([companyProfileId, adminId, runId, toolCallId], map: "AssistantToolTrace_run_call_key")
  @@index([companyProfileId, adminId, runId, createdAt, id], map: "AssistantToolTrace_run_time_idx")
}

enum PlanTier {
  starter
  pro
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

/// T-027: SaaS plan catalog. Seeded with `starter`, `pro`, `enterprise` and
/// mirrors a Stripe price. Dedicated deployments ignore this table.
model Plan {
  id                String   @id @default(cuid())
  tier              PlanTier @unique
  displayName       String
  priceCents        Int      @default(0)
  currency          String   @default("EUR")
  billingIntervalMo Int      @default(1)
  /// Stripe price id. Nullable so the catalog can seed before checkout is wired.
  stripePriceId     String?  @unique
  isActive          Boolean  @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// T-027: exactly one subscription per Company. `trialing` on signup. Stripe
/// webhook updates status idempotently keyed on `stripeSubscriptionId`.
model Subscription {
  id                   String             @id @default(cuid())
  companyProfileId     String             @unique
  companyProfile       CompanyProfile     @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  planId               String?
  plan                 Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  status               SubscriptionStatus @default(trialing)
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum AuditActorType {
  ADMIN
  WORKER
  SYSTEM
}

/// T-033: sensitive-action audit log. One row per meaningful state change
/// (billing, admin management, exports, mode changes, plan-limit blocks).
/// Scope: per-tenant. Payload is a Prisma Json field — callers redact PII
/// before writing.
model AuditLog {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  actorType AuditActorType
  actorId   String?
  action    String
  payload   Json           @default("{}")

  createdAt DateTime @default(now())

  @@index([companyProfileId, createdAt])
  @@index([action, createdAt])
}

/// T-034: per-tenant token for the fleet GPS ingest endpoint. Replaces the
/// single `FLEET_GPS_INGEST_TOKEN` env var so SaaS tenants each have their
/// own credential. Dedicated deployments may keep using the env var alongside
/// or migrate to a per-tenant token — both paths are supported by
/// `resolveFleetIngestTenant`.
model FleetIngestToken {
  id               String    @id @default(cuid())
  companyProfileId String
  token            String    @unique
  label            String?
  isActive         Boolean   @default(true)
  lastUsedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyProfileId, isActive])
}

/// T-027: idempotency ledger for Stripe webhook events. Each Stripe event id
/// is recorded once so replays are noops.
model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  receivedAt    DateTime @default(now())
}

model WorkzoneAnnouncement {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  message          String
  isActive         Boolean @default(true)
  createdByAdminId String?
  createdByName    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyProfileId, isActive, createdAt])
}

model CompanyKnowledge {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  language AssistantLanguage @default(DE)
  key      String
  title    String
  content  String
  tags     String[]          @default([])
  isActive Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyProfileId, key])
  @@index([companyProfileId, isActive])
  @@index([companyProfileId, language])
}

model CompanyInventoryCatalog {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  name          String
  category      SiteEquipmentCategory
  totalQuantity Int                   @default(0)
  isActive      Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyProfileId, category])
  @@index([companyProfileId, isActive])
}

model CompanyInventoryItem {
  operationalAsset CompanyOperationalAsset?
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  category  CompanyInventoryCategory
  itemCode  String
  barcode   String?                  @unique
  name      String
  sizeLabel String?
  note      String?
  isActive  Boolean                  @default(true)

  workerAssignments WorkerAssetItem[]
  movementHistory   InventoryAssetMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyProfileId, itemCode])
  @@unique([companyProfileId,id])
  @@index([companyProfileId, category])
  @@index([isActive])
}

model OverheadSettings {
  id               String         @id @default(cuid())
  companyProfileId String         @unique
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  bgkPct    Decimal @default(0.15) @db.Decimal(7, 4)
  agkPct    Decimal @default(0.10) @db.Decimal(7, 4)
  riskPct   Decimal @default(0.03) @db.Decimal(7, 4)
  profitPct Decimal @default(0.05) @db.Decimal(7, 4)
  vatPct    Decimal @default(0.19) @db.Decimal(7, 4)

  bgkBase           OverheadBase   @default(EK_TOTAL)
  riskProfitMode    RiskProfitMode @default(SEPARATE)
  applyVatByDefault Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LaborRole {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  name String

  wageType          WageType @default(HOURLY)
  grossHourlyCents  Int?
  grossMonthlyCents Int?

  employerOverheadPct Decimal @default(0.25) @db.Decimal(7, 4)
  productivityPct     Decimal @default(0.85) @db.Decimal(7, 4)
  absencePct          Decimal @default(0.00) @db.Decimal(7, 4)

  notes     String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  laborItems PositionLaborItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyProfileId, name])
}

model Machine {
  operationalAsset CompanyOperationalAsset?
  wanwayDevices WanwayDevice[]
  fuelReceipts FuelReceipt[]
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  name     String
  category MachineCategory @default(OTHER)

  hourlyRateCents Int
  dayRateCents    Int?

  nickname          String?
  model             String?
  targe             String?
  vitiProdhimit     Int?
  vitiBlerjes       Int?
  tuvDate           DateTime?
  auDate            DateTime?
  huStatus          String?
  spDate            DateTime?
  spStatus          String?
  uvvDate           DateTime?
  uvvStatus         String?
  funksioni         String?
  patentaEnevojshme String?
  imageUrl          String?
  coverPhotoAt      DateTime?
  coverPhoto        AssetPhoto?
  /// Albanian vehicle papers (Kolaudimi uses tuvDate): insurance, road tax,
  /// transport permit and tachograph check, each the day it runs out.
  insuranceDate       DateTime?
  taxDate             DateTime?
  transportPermitDate DateTime?
  tachographDate      DateTime?
  /// Registered owner when it is not the company itself (leased, private car).
  ownership           String?
  tonnage             Float?

  notes       String?
  isActive    Boolean   @default(true)
  /// Private vehicle: only the people named in PRIVATE_VEHICLES_ONLY see it in Flota and GPS.
  isPrivate   Boolean   @default(false)
  gpsEnabled  Boolean   @default(false)
  gpsDeviceId String?   @unique
  lastGpsLat  Decimal?  @db.Decimal(10, 7)
  lastGpsLng  Decimal?  @db.Decimal(10, 7)
  lastGpsAt   DateTime?

  coneTotal Int @default(0)

  machineItems         PositionMachineItem[]
  dailyPlanAssignments DailyWorkPlanAssignment[]
  coneMovementsFrom    MachineConeMovement[]      @relation("ConeFromMachine")
  coneMovementsTo      MachineConeMovement[]      @relation("ConeToMachine")
  gpsLocationPoints    GpsLocationPoint[]
  baustellePresences   MachineBaustellePresence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyProfileId, name])
  @@unique([companyProfileId, id])
}

/// Private fuel evidence: immutable uploader/upload time, confirmed invoice time
/// and only the nearest GPS evidence for that event, never a continuous archive.
model FuelReceipt {
  id                   String @id @default(cuid())
  companyProfileId     String
  companyProfile       CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  machineId            String
  machine              Machine @relation(fields: [companyProfileId, machineId], references: [companyProfileId, id], onDelete: NoAction, map: "FuelReceipt_machine_tenant_fkey")
  requestId            String
  uploadedByUserId      String?
  uploadedByWorkerId    String?
  uploadedByName        String
  uploadedAt           DateTime @default(now())
  confirmedAt          DateTime?
  fueledAt             DateTime?
  fueledByWorkerId     String?
  fueledByUserId       String?
  fueledByName         String?
  timeZone             String
  receiptTime          String?
  timeSource           String?
  stationAddress       String?
  liters               Float?
  amount               Float?
  currency             String
  fileName             String
  mime                 String
  size                 Int
  data                 Bytes
  sha256               String
  gpsStatus            String @default("pending")
  gpsDeviceId          String?
  gpsLat               Float?
  gpsLng               Float?
  gpsRecordedAt        DateTime?
  gpsDeltaSeconds      Int?
  gpsSource            String?
  gpsEvidence          Json?
  gpsResolvedAt        DateTime?

  @@unique([companyProfileId, requestId])
  @@index([companyProfileId, machineId, uploadedAt])
}

/// Server-only provider credentials and distributed operation/token cache.
model WanwayIntegration {
  companyProfileId String @id
  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  appid String?
  encryptedKey String?
  encryptedToken String?
  tokenExpiresAt DateTime?
  status String @default("disconnected")
  lastSuccessfulSync DateTime?
  lastError String?
  nextRequestAt DateTime @default(now())
  busyUntil DateTime @default(now())
  operationId String?
  devices WanwayDevice[]
  updatedAt DateTime @updatedAt
}

model WanwayDevice {
  id String @id @default(cuid())
  companyProfileId String
  integration WanwayIntegration @relation(fields: [companyProfileId], references: [companyProfileId], onDelete: Cascade)
  imei String
  name String
  model String?
  machineId String?
  machine Machine? @relation(fields: [companyProfileId, machineId], references: [companyProfileId, id], onDelete: Cascade, map: "WanwayDevice_machine_tenant_fkey")
  available Boolean @default(true)
  plate String?
  lat Float?
  lng Float?
  reportedAt DateTime?
  signalAt DateTime?
  providerStatus String?
  speedKmh Float?
  voltage Float?
  mileage24hKm Float?
  mileageAt DateTime?
  mileageError String?
  syncedAt DateTime?
  @@unique([companyProfileId, imei])
  @@unique([companyProfileId, machineId])
}

model MachineConeMovement {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  type     MachineConeMovementType
  quantity Int

  fromMachineId String?
  fromMachine   Machine? @relation("ConeFromMachine", fields: [fromMachineId], references: [id], onDelete: SetNull)
  toMachineId   String?
  toMachine     Machine? @relation("ConeToMachine", fields: [toMachineId], references: [id], onDelete: SetNull)

  baustelleId String?
  baustelle   Baustelle? @relation(fields: [baustelleId], references: [id], onDelete: SetNull)
  treeItemId  String?
  treeItem    TreeItem?  @relation(fields: [treeItemId], references: [id], onDelete: SetNull)

  actorRole     MachineConeActorRole
  actorWorkerId String?
  actorWorker   Worker?              @relation("ConeActorWorker", fields: [actorWorkerId], references: [id], onDelete: SetNull)
  actorAdminId  String?
  actorAdmin    User?                @relation("ConeActorAdmin", fields: [actorAdminId], references: [id], onDelete: SetNull)
  actorName     String?

  note String?

  createdAt DateTime @default(now())

  @@index([companyProfileId, createdAt])
  @@index([fromMachineId, createdAt])
  @@index([toMachineId, createdAt])
  @@index([baustelleId, createdAt])
