  workerId           String?
  worker             Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  resolvedByUserId   String?
  resolvedByUser     User?     @relation("ManualTaskResolvedByUser", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedByWorkerId String?
  resolvedByWorker   Worker?   @relation("ManualTaskResolvedByWorker", fields: [resolvedByWorkerId], references: [id], onDelete: SetNull)
