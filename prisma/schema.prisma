  diameter            Int
  coordinates         Json?
  status              TreeItemStatus @default(todo)
  notes               String?
  siteEquipmentStatus Json?
  isEdited            Boolean        @default(false)
  lastEditedBy        String?
  lastEditedAt        DateTime?

  completedAt         DateTime?
