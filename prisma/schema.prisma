  inventoryMovements InventoryMovement[]
  coneMovements      MachineConeMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([baustelleId, id])

  @@unique([baustelleId, treeId])
  @@index([baustelleId])
  @@index([treeId])
}

