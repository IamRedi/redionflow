/// Immutable file versions; active company readers acknowledge their own receipt.
model SitePhaseDocument {
  id String @id @default(uuid())
  companyProfileId String
  companyProfile CompanyProfile @relation(fields:[companyProfileId],references:[id],onDelete:Cascade)
  baustelleId String
  baustelle Baustelle @relation(fields:[companyProfileId,baustelleId],references:[companyProfileId,id],onDelete:Restrict)
  phase String
  title String
  note String @default("")
  fileName String
  mime String
  size Int
  dataBytes Bytes
  sha256 String
  createdByUserId String?
  createdByUser User? @relation("PhaseDocumentUser",fields:[companyProfileId,createdByUserId],references:[companyProfileId,id],onDelete:Restrict)
  createdByWorkerId String?
  createdByWorker Worker? @relation("PhaseDocumentWorker",fields:[companyProfileId,createdByWorkerId],references:[companyProfileId,id],onDelete:Restrict)
  createdByKey String
  createdByName String
  supersedesId String?
  supersedes SitePhaseDocument? @relation("PhaseDocumentVersion",fields:[companyProfileId,baustelleId,phase,supersedesId],references:[companyProfileId,baustelleId,phase,id],onDelete:Restrict)
  nextVersion SitePhaseDocument? @relation("PhaseDocumentVersion")
  createdAt DateTime @default(now())
  archivedAt DateTime?
  archivedByKey String?
  receipts SitePhaseDocumentReceipt[]
  @@unique([companyProfileId,id])
  @@unique([companyProfileId,baustelleId,phase,id])
  @@unique([companyProfileId,baustelleId,phase,supersedesId])
  @@index([companyProfileId,baustelleId,phase,createdAt])
}

model SitePhaseDocumentReceipt {
  id String @id @default(cuid())
  companyProfileId String
  companyProfile CompanyProfile @relation(fields:[companyProfileId],references:[id],onDelete:Cascade)
  documentId String
  document SitePhaseDocument @relation(fields:[companyProfileId,documentId],references:[companyProfileId,id],onDelete:Restrict)
  actorKey String
  actorName String
  userId String?
  user User? @relation("PhaseReceiptUser",fields:[companyProfileId,userId],references:[companyProfileId,id],onDelete:Restrict)
  workerId String?
  worker Worker? @relation("PhaseReceiptWorker",fields:[companyProfileId,workerId],references:[companyProfileId,id],onDelete:Restrict)
  receivedAt DateTime @default(now())
  @@unique([companyProfileId,documentId,actorKey])
  @@index([companyProfileId,actorKey,receivedAt])
}

model SiteFile {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  baustelleId      String
  baustelle        Baustelle      @relation(fields: [baustelleId], references: [id], onDelete: Cascade)
  /// document | photo | order | invoice
  kind             String
  /// true: only the office (admins) may see it (prices, invoices).
  officeOnly       Boolean        @default(false)
  fileName         String
  mime             String
  size             Int
  data             Bytes
  amount           Float?
  currency         String?
  supplier         String?
  reference        String?
  uploadedByName   String         @default("")
  createdAt        DateTime       @default(now())

  @@index([companyProfileId])
  @@index([baustelleId, kind])
}

/// One element of a steel project as the drawing office lists it (Tekla
/// "Lista assemblaggi" = assemblies like B/12 or C/40, "Lista parti" = cut
/// parts like plate 1001). The factory and the field team check off, per
/// element and stage, which workers made or mounted it.
model SiteElement {
  processRoutes Json?
  processRevision Int @default(0)
  processEditedBy String?
  processEditedAt DateTime?
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  baustelleId      String
  baustelle        Baustelle      @relation(fields: [baustelleId], references: [id], onDelete: Cascade)
  /// assembly | part
  list             String
  /// Drawing mark: "B/12", "C/40", "1001".
  mark             String
  /// BEAM, COLUMN, ... (assemblies only).
  kind             String?
  profile          String?
  material         String?
  quantity         Int            @default(1)
  lengthMm         Float?
  /// Per piece.
  weightKg         Float?
  areaM2           Float?
  sortIndex        Int            @default(0)
  sourceFile       String?
  /// The factory engineer finished the element: the steps it went through are
  /// its route, the others are not needed. Pieces that passed every step of
  /// the route are on the field list, the rest stays in the factory.
  factoryDoneAt    DateTime?
  factoryDoneBy    String?
  /// The same on site, for the field steps.
  fieldDoneAt      DateTime?
  fieldDoneBy      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  work             SiteElementWork[]

  @@unique([baustelleId, list, mark])
  @@index([companyProfileId])
}

/// Who did one stage of one element: factory steps (cutting ... loading) or
/// "mounted" on site. Saved by the engineer who checked it.
model SteelWorkDefinition {
  id String @id @default(cuid())
  companyProfileId String
  companyProfile CompanyProfile @relation(fields:[companyProfileId],references:[id],onDelete:Cascade)
  kind String
  key String
  label String @default("")
  description String @default("")
  sortOrder Int @default(0)
  revision Int @default(1)
  archivedAt DateTime?
  linkedProcessKey String?
  linkedList String?
  linkedKind String?
  /// Site tasks only: which of the three site windows it belongs to (concrete | production | assembly). Null = assembly.
  phaseGroup String?
  visualUpdatedAt DateTime?
  visualStatus String @default("fallback")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  siteTasks SteelSiteTask[]
  visual SteelWorkVisual?
  @@unique([companyProfileId,id])
  @@unique([companyProfileId,key])
  @@index([companyProfileId,kind,archivedAt,sortOrder])
}

model SteelWorkVisual {
  id String @id @default(cuid())
  companyProfileId String
  companyProfile CompanyProfile @relation(fields:[companyProfileId],references:[id],onDelete:Cascade)
  definitionId String @unique
  definition SteelWorkDefinition @relation(fields:[companyProfileId,definitionId],references:[companyProfileId,id],onDelete:Cascade)
  data Bytes?
  scene Json?
  mime String
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([companyProfileId,definitionId])
}

model SteelSiteTask {
  id String @id @default(cuid())
  companyProfileId String
  companyProfile CompanyProfile @relation(fields:[companyProfileId],references:[id],onDelete:Cascade)
  baustelleId String
  baustelle Baustelle @relation(fields:[companyProfileId,baustelleId],references:[companyProfileId,id],onDelete:Cascade)
  definitionId String
  definition SteelWorkDefinition @relation(fields:[companyProfileId,definitionId],references:[companyProfileId,id],onDelete:Restrict)
  treeItemId String @unique
  treeItem TreeItem @relation(fields:[baustelleId,treeItemId],references:[baustelleId,id],onDelete:Cascade)
  enabled Boolean @default(true)
  /// Order on the site board: the order the phases were chosen (1, 2, 3 …).
  position Int?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([companyProfileId,baustelleId,definitionId])
  @@unique([baustelleId,treeItemId])
  @@index([companyProfileId,definitionId])
}

model SiteElementWork {
  id                String         @id @default(cuid())
  companyProfileId  String
  companyProfile    CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  elementId         String
  element           SiteElement    @relation(fields: [elementId], references: [id], onDelete: Cascade)
  stage             String
  /// Pieces of the element done in this entry (0 = all, older checks). One
  /// step may have several entries: 2 pieces today, 2 tomorrow by others.
  pieces            Int            @default(0)
  workerIds         String[]
  /// Names at the time of checking, so the record stays readable.
  workerNames       String         @default("")
  checkedByName     String
  checkedByUserId   String?
  checkedByWorkerId String?
  checkedAt         DateTime       @default(now())
  /// Immutable list/mark/quantity/unit-weight at confirmation. Null = legacy.
  productionSnapshot Json?

  @@index([elementId, stage])
  @@index([companyProfileId])
  @@index([companyProfileId, checkedAt, id])
}

/// What the assistant notices for the platform team: a missing feature the
/// user asked for, a bug, a question the guide could not answer, or a system
/// error. Forwarded to the operator's hub (REDION_HUB_URL) when configured.
model PlatformSignal {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  kind             String
  title            String
  details          String         @default("")
  fingerprint      String
  count            Int            @default(1)
  actorKind        String
  actorId          String
  actorName        String         @default("")
  language         String         @default("")
  source           String         @default("assistant")
  createdAt        DateTime       @default(now())
  lastSeenAt       DateTime       @default(now())
  forwardedAt      DateTime?
  forwardAttempts  Int            @default(0)

  @@unique([companyProfileId, fingerprint])
  @@index([companyProfileId, forwardedAt])
}
