{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/backup-cron/Dockerfile",
    "watchPatterns": ["ops/backup-cron/**", "scripts/backup-cron.ts", "scripts/database-backup.ts", "src/lib/backup/**", "package-lock.json"]
  },
  "deploy": {
    "cronSchedule": "0 19 * * *",
    "restartPolicyType": "NEVER"
  }
}
