{
  "name": "redionflow",
  "version": "1.0.0",
  "description": "RediOnFlow – BaumdienstFlow & BauFlow: Einsatz-, Baustellen- und Kalkulationsplattform für Baumdienst- und Baubetriebe.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -H 0.0.0.0 -p 8080",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:studio": "prisma studio",
    "db:export": "tsx scripts/export-local-data.ts",
    "storage:migrate-local": "tsx scripts/migrate-local-uploads-to-storage.ts",
    "db:reset:workzone": "tsx scripts/reset-workzone-data.ts",
    "db:reset:cones": "tsx scripts/reset-cones-data.ts",
    "db:reset:demo": "tsx scripts/reset-demo-database.ts",
    "check:saas-env": "tsx scripts/validate-saas-env.ts",
    "login-attempts:cleanup": "tsx scripts/login-attempts-cleanup.ts",
    "i18n:coverage": "tsx scripts/i18n-coverage-report.ts",
    "test": "vitest run",
    "test:e2e": "SAAS_MODE=true APP_ENV=saas playwright test",
    "test:e2e:local": "tsx scripts/e2e-local.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:local": "tsx scripts/test-integration-local.ts",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Redion Cekrezi",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/react": "^3.0.170",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@zxing/browser": "^0.1.5",
    "ai": "^6.0.168",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "fast-xml-parser": "^5.7.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "16.3.8",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.2",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IamRedi/redionflow.git"
  }
}
